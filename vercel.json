{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.4" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/session\\.php", "status": 404 },
    { "src": "/(.*)\\.(css|js|png)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.php" }
  ]
}
